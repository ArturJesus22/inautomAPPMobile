{
  "expo": {
    "name": "Inautom Control",
    "slug": "InautomControl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/inautom-ico.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.arturjesus.inautomappmobile",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.arturjesus.inautomappmobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.arturjesus.inautomappmobile",
      "amazonAppstoreUrl": "https://www.amazon.com/dp/[seu-app-id]",
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ],
          "data": {
            "scheme": "inautomcontrol",
            "host": "app"
          }
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "72b61a60-514e-4a87-ab0f-3fab2e77867b"
      }
    }
  }
}
